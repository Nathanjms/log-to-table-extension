{
  "name": "laravel-log-viewer-table",
  "displayName": "Log to Table - Laravel & More",
  "description": "View your Log files in a easy-to-read table, with filters and pagination. Works with Laravel logs out the box, with the ability to add more regex patterns for other .log files.",
  "icon": "images/logo.png",
  "author": "Nathan James <nathan@nathanjms.co.uk>",
  "publisher": "nathanjames",
  "homepage": "https://github.com/Nathanjms/log-to-table-extension#readme",
  "bugs": {
    "url": "https://github.com/Nathanjms/log-to-table-extension/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nathanjms/log-to-table-extension.git"
  },
  "license": "MIT",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "logs",
    "laravel",
    "viewer",
    "table"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "log-viewer.formatLogs",
        "title": "Log to Table: View as Table"
      },
      {
        "command": "log-viewer.findAndOpen",
        "title": "Log to Table: Find and Open Log"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "log-viewer.formatLogs",
          "when": "resourceLangId == log",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check",
    "compile": "tsc -p .",
    "watch": "tsc --watch -p .",
    "lint": "eslint src media/assets/logViewer.js --max-warnings=0",
    "check": "npm run compile && npm run lint",
    "pretest": "npm run check",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.93.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@alpinejs/csp": "3.17.4",
    "safe-regex2": "5.1.2"
  }
}
